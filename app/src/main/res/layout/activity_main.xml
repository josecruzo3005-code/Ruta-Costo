<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RUTACOSTO" android:textSize="28sp" android:textStyle="bold" android:paddingBottom="6dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compara el costo real de tus rutas" android:textSize="16sp" android:paddingBottom="18dp"/>
        <EditText android:id="@+id/origin" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Origen (ciudad, dirección o lugar)" android:inputType="textCapSentences"/>
        <Button android:id="@+id/location_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Usar mi ubicación"/>
        <EditText android:id="@+id/destination" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Destino (ciudad, dirección o lugar)" android:inputType="textCapSentences"/>
        <EditText android:id="@+id/consumption" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Consumo (km/galón)" android:inputType="numberDecimal"/>
        <EditText android:id="@+id/fuel_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Precio combustible por galón (COP)" android:inputType="numberDecimal"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Peajes por ruta (COP). Ingresa el total estimado de cada opción; usa 0 si no aplica." android:textSize="14sp" android:paddingTop="8dp"/>
        <EditText android:id="@+id/toll1" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Peajes ruta 1 (más rápida, si aparece)" android:inputType="numberDecimal"/>
        <EditText android:id="@+id/toll2" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Peajes ruta 2 (COP)" android:inputType="numberDecimal"/>
        <EditText android:id="@+id/toll3" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Peajes ruta 3 (COP)" android:inputType="numberDecimal"/>
        <Button android:id="@+id/calculate_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CALCULAR RUTAS" android:layout_marginTop="14dp"/>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Escribe origen y destino para calcular." android:textSize="15sp" android:paddingTop="14dp"/>
        <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aquí aparecerán las rutas." android:textSize="17sp" android:paddingTop="14dp" android:paddingBottom="24dp"/>
    </LinearLayout>
</ScrollView>